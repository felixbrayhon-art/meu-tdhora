# .env.example
# Esta chave é necessária para que as funcionalidades de IA funcionem quando o app for exportado ou implantado fora dos ambientes do AI Studio (Vercel, Netlify, etc).
# No Vercel, use preferencialmente VITE_GEMINI_API_KEY como nome da variável.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Opcional: chave da OpenRouter (openrouter.ai/keys), usada como fallback automático
# quando a chave do Gemini acima estoura cota (429) ou o Google está indisponível (503).
# Sem esta chave, o app funciona normalmente e só mostra o erro do Gemini como antes.
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
