# .env.example
# Esta chave é necessária para que as funcionalidades de IA funcionem quando o app for exportado ou implantado fora dos ambientes do AI Studio (Vercel, Netlify, etc).
# No Vercel, use preferencialmente VITE_GEMINI_API_KEY como nome da variável.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Opcional: chave da Groq (console.groq.com/keys), tentada ANTES da OpenRouter
# como fallback quando o Gemini acima estoura cota (429) ou fica indisponível (503) —
# roda em hardware próprio da Groq, mais confiável que o pool gratuito da OpenRouter.
VITE_GROQ_API_KEY=
GROQ_API_KEY=

# Opcional: chave da OpenRouter (openrouter.ai/keys), usada como segundo fallback
# se Gemini e Groq acima falharem.
# Sem nenhuma das duas chaves, o app funciona normalmente e só mostra o erro do Gemini como antes.
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
