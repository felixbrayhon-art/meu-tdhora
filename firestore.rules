rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin status is a plain doc under /admins — existence, not content,
    // is what matters. Docs here are never writable from the client; the
    // first (and so far only) admin is created by hand in the Firebase
    // console, not through the app.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATIONS ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'avatarColor', 'level', 'xp', 'streak']) &&
             data.name is string && data.name.size() <= 100 &&
             data.avatarColor is string && data.avatarColor.size() <= 20 &&
             data.level is number && data.xp is number &&
             data.streak is number &&
             (!('coins' in data) || data.coins is number) &&
             (!('totalDaysStudied' in data) || data.totalDaysStudied is number) &&
             (!('lastStudyDate' in data) || data.lastStudyDate is string) &&
             (!('studyProfile' in data) || data.studyProfile is string);
    }

    function isValidFlashcard(data) {
      return data.keys().hasAll(['id', 'question', 'answer', 'topic']) &&
             data.id is string && data.id.size() <= 128 &&
             data.question is string && data.question.size() <= 5000 &&
             data.answer is string && data.answer.size() <= 10000 &&
             data.topic is string && data.topic.size() <= 200;
    }

    function isValidQuizFolder(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.createdAt is number;
    }

    function isValidNotebook(data) {
      return data.keys().hasAll(['id', 'name', 'questions', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.questions is list && data.questions.size() <= 500 &&
             data.createdAt is number &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 20000));
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['name', 'avatarColor', 'level', 'xp', 'status']) &&
             data.name is string && data.name.size() <= 100 &&
             data.avatarColor is string && data.avatarColor.size() <= 20 &&
             data.level is number && data.xp is number &&
             data.status is string &&
             (!('characterId' in data) || data.characterId is string) &&
             (!('lastActive' in data) || data.lastActive is number);
    }

    function isValidDirectoryEntry(data) {
      return data.keys().hasAll(['uid']) && data.uid is string && data.uid == request.auth.uid;
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['fromUid', 'toUid', 'fromName', 'fromAvatarColor', 'createdAt']) &&
             data.fromUid is string && data.toUid is string &&
             data.fromUid != data.toUid &&
             data.fromName is string && data.fromName.size() <= 100 &&
             data.fromAvatarColor is string && data.fromAvatarColor.size() <= 20 &&
             data.createdAt is number;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'timestamp']) &&
             data.senderId is string &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.timestamp is number;
    }

    // --- COLLECTION MATCHES ---

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      
      // Flashcards
      match /flashcards/{cardId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFlashcard(incoming()) && isValidId(cardId);
        allow update: if isOwner(userId) && isValidFlashcard(incoming());
        allow delete: if isOwner(userId);
      }

      // Flashcard Folders
      match /flashcardFolders/{folderId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(folderId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Quiz Folders
      match /quizFolders/{folderId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuizFolder(incoming()) && isValidId(folderId);
        allow update: if isOwner(userId) && isValidQuizFolder(incoming());
        allow delete: if isOwner(userId);

        // Notebooks
        match /notebooks/{notebookId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId);
          allow create: if isOwner(userId) && isValidNotebook(incoming()) && isValidId(notebookId);
          allow update: if isOwner(userId) && isValidNotebook(incoming());
          allow delete: if isOwner(userId);
        }
      }

      // Configurations
      match /configs/{configId} {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId);
      }
      
      // Settings
      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // PUBLIC PROFILES — minimal info a friend needs to render a friend card.
    // Only readable by uid (never listed), so a user must already know the
    // uid (via a friendship or a directory-code lookup) to fetch it.
    match /publicProfiles/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidPublicProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // FRIEND CODE DIRECTORY — code -> uid lookup so a friend can be added by
    // a short shareable code instead of a raw uid. Immutable once created;
    // never listable, so the directory can't be scraped.
    match /userDirectory/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidDirectoryEntry(incoming());
      allow update, delete: if false;
    }

    // FRIEND REQUESTS — doc id is `${fromUid}_${toUid}`.
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == incoming().fromUid &&
                     requestId == incoming().fromUid + '_' + incoming().toUid &&
                     isValidFriendRequest(incoming());
      allow delete: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // FRIENDSHIPS — doc id is the two uids sorted and joined with '_'.
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                     request.auth.uid in incoming().participants &&
                     incoming().participants.size() == 2 &&
                     friendshipId == pairId(incoming().participants[0], incoming().participants[1]);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    // DIRECT MESSAGES — chatId matches its friendship's id, so only the two
    // participants of an existing friendship can ever exchange messages.
    match /chats/{chatId}/messages/{messageId} {
      allow list: if isSignedIn() && chatId.split('_').hasAny([request.auth.uid]);
      allow get: if isSignedIn() && chatId.split('_').hasAny([request.auth.uid]);
      allow create: if isSignedIn() && chatId.split('_').hasAny([request.auth.uid]) &&
                     exists(/databases/$(database)/documents/friendships/$(chatId)) &&
                     incoming().senderId == request.auth.uid &&
                     isValidMessage(incoming());
      allow update, delete: if false;
    }

    // --- QUESTION BANK IMPORT PIPELINE (admin-only) ---
    // Populated by worker/scripts/push_drafts.py via the Admin SDK, which
    // bypasses these rules entirely — they only govern what the admin
    // review UI (running as a normal signed-in client) can do afterward.

    // Existence-only doc; content (if any) is never trusted by these rules.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /imports/{importId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false; // written only by the Admin SDK push script
    }

    function isValidQuestionDraft(data) {
      return data.keys().hasAll(['importId', 'source', 'statement', 'alternatives', 'status']) &&
             data.importId is string &&
             data.source is string &&
             data.statement is string && data.statement.size() <= 20000 &&
             data.alternatives is list && data.alternatives.size() <= 10 &&
             data.status is string &&
             (!('correctLetter' in data) || data.correctLetter == null || data.correctLetter is string) &&
             (!('explanation' in data) || data.explanation is string && data.explanation.size() <= 40000) &&
             (!('subjectRaw' in data) || data.subjectRaw == null || data.subjectRaw is string) &&
             (!('topicRaw' in data) || data.topicRaw == null || data.topicRaw is string);
    }

    match /question_drafts/{draftId} {
      allow get, list: if isAdmin();
      // Admin can edit a draft in place (review) and delete it once approved
      // or rejected — but never create one; that's the push script's job.
      allow update: if isAdmin() && isValidQuestionDraft(incoming());
      allow delete: if isAdmin();
      allow create: if false; // written only by the Admin SDK push script
    }

    function isValidPublishedQuestion(data) {
      return data.keys().hasAll(['source', 'statement', 'alternatives', 'approvedBy', 'approvedAt']) &&
             data.source is string &&
             data.statement is string && data.statement.size() <= 20000 &&
             data.alternatives is list && data.alternatives.size() <= 10 &&
             data.approvedBy == request.auth.uid &&
             data.approvedAt is number;
    }

    // The published bank every signed-in student reads from. Only an admin
    // can write — normally via "aprovar" in the review UI, which copies a
    // draft here.
    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidPublishedQuestion(incoming());
      // Narrow path for QuizPlayer's admin "editar explicação" toggle: fixing
      // an already-published question's explanation shouldn't have to satisfy
      // isValidPublishedQuestion's approvedBy/approvedAt shape again (worker
      // imports set approvedBy to an importer email and approvedAt to a
      // Firestore Timestamp via the Admin SDK, neither of which matches what
      // that function expects from a client-side approval write) — this only
      // ever touches `explanation`, nothing else.
      allow update: if isAdmin()
                    && incoming().diff(existing()).affectedKeys().hasOnly(['explanation'])
                    && incoming().explanation is string
                    && incoming().explanation.size() <= 20000;
      allow delete: if isAdmin();
    }
  }
}
